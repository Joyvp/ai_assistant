[Unit]
Description=APEXIS — check for queued work every few minutes
Documentation=https://github.com/Joyvp/ai_assistant

[Timer]
# An absolute schedule, not one relative to the last run.
#
# The first version used OnStartupSec + OnUnitActiveSec, and systemd showed
# NEXT as "-" after the first fire: with a oneshot service the chain can
# lapse and never schedule again. A wall-clock schedule always knows when
# the next one is, through sleeps, reboots and closed lids.
OnCalendar=*:0/5

# Catch up once if the machine was asleep when a run was due, rather than
# firing every missed run at once.
Persistent=true

# Do not stampede on the minute alongside every other timer on the system.
RandomizedDelaySec=30
AccuracySec=1min

[Install]
WantedBy=timers.target
